{
  "name": "ember",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @ember/config build && pnpm -r --parallel dev",
    "dev:mock": "pnpm --filter @ember/config build && pnpm --filter @ember/web dev:mock",
    "build": "pnpm -r build",
    "build:mock": "pnpm --filter @ember/config build && pnpm --filter @ember/domain build && pnpm --filter @ember/web build:mock",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @ember/web test:e2e",
    "db:migrate": "pnpm --filter @ember/db migrate",
    "docker:dev": "docker compose up --build",
    "docker:dev:down": "docker compose down",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down"
  },
  "engines": {
    "node": ">=20"
  }
}
