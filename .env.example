# App
EMBER_APP_URL=http://localhost:3000
EMBER_API_PORT=3001
EMBER_DEFAULT_COMMUNITY_SLUG=gsa-pilot
EMBER_SESSION_SECRET=change-me-local-dev-session

# Database
EMBER_DB_PATH=data/ember.db

# Email provider: noop | logging | smtp | resend
EMBER_EMAIL_PROVIDER=noop
EMBER_EMAIL_FROM="Ember <dev@localhost>"
EMBER_EMAIL_PEPPER=change-me-local-dev

# SMTP (dev / Mailpit)
EMBER_SMTP_HOST=127.0.0.1
EMBER_SMTP_PORT=1025
EMBER_SMTP_SECURE=false
EMBER_SMTP_USER=
EMBER_SMTP_PASS=

# Resend (staging / prod)
RESEND_API_KEY=
