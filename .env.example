# App — portas padrão em config/dev-ports.json (web 2000, api 2001)
EMBER_APP_URL=http://localhost:2000
EMBER_API_PORT=2001
EMBER_DEFAULT_COMMUNITY_SLUG=gsa-pilot
EMBER_SESSION_SECRET=change-me-local-dev-session
EMBER_BOOTSTRAP_FACILITATOR_EMAIL=you@example.com
EMBER_JITSI_BASE_URL=https://meet.jit.si

# Database
EMBER_DB_PATH=data/ember.db

# Email provider: noop | logging | smtp | resend
EMBER_EMAIL_PROVIDER=noop
EMBER_EMAIL_FROM="Ember <dev@localhost>"
EMBER_EMAIL_PEPPER=change-me-local-dev

# SMTP (dev / Mailpit)
EMBER_SMTP_HOST=127.0.0.1
EMBER_SMTP_PORT=1025
EMBER_SMTP_SECURE=false
EMBER_SMTP_USER=
EMBER_SMTP_PASS=

# Geoapify (autocomplete de cidades — origem e residência no perfil)
EMBER_GEOAPIFY_API_KEY=
