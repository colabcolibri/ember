# syntax=docker/dockerfile:1

FROM node:20-bookworm-slim AS base

ENV CI=true

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable \
  && corepack prepare pnpm@9 --activate

WORKDIR /app

FROM base AS build

COPY . .

RUN pnpm install --frozen-lockfile \
  && pnpm --filter @ember/config build \
  && pnpm --filter @ember/domain build \
  && pnpm --filter @ember/db build \
  && pnpm --filter @ember/email build \
  && pnpm --filter @ember/api build \
  && pnpm --filter @ember/api deploy --prod --legacy /prod/api

FROM base AS runtime

ENV NODE_ENV=production

WORKDIR /app

COPY --from=build /prod/api ./
COPY docker/api-entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

EXPOSE 2001

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:2001/api/v1/health').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/entrypoint.sh"]
