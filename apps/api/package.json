    "@ember/domain": "workspace:*",
    "@ember/email": "workspace:*",
    "@hono/node-server": "^1.14.4",
    "hono": "^4.7.11",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  }
}
